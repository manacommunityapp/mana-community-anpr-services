APP_ENV=development
APP_PORT=8001

# mana-community-service webhook
MANA_BACKEND_WEBHOOK_URL=http://localhost:8080/api/parking/anpr/webhook
MANA_BACKEND_API_KEY=your-shared-secret-here

# Model
YOLO_MODEL_PATH=models/yolov8_plate.pt
OCR_LANGUAGES=en
OCR_GPU=false
MIN_CONFIDENCE=0.80
MIN_OCR_CONFIDENCE=0.75

# RTSP Gate Cameras (add as many gates as needed)
CAMERA_GATE_MAIN_IN=rtsp://admin:password@192.168.1.101:554/stream1
CAMERA_GATE_MAIN_OUT=rtsp://admin:password@192.168.1.102:554/stream1
CAMERA_GATE_BASEMENT=rtsp://admin:password@192.168.1.103:554/stream1

# RTSP stream sampling (frames per second to process)
STREAM_SAMPLE_FPS=2

# Local event log DB (optional)
DB_URL=sqlite+aiosqlite:///./anpr_events.db

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
